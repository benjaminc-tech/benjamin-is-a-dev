---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const fmt = (d) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
---

<Base title={`${post.data.title}, Benjamin Goldberger`} description={post.data.summary} path={`/blog/${post.id}/`}>
  <a class="back" href="/blog">← writing</a>

  <h1>{post.data.title}</h1>
  <p class="sub">
    <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
    {post.data.draft && <strong> · draft</strong>}
  </p>

  <article class="prose">
    <Content />
  </article>
</Base>
